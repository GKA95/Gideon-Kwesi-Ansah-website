# MongoDB Atlas Configuration (Required)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="gka_portfolio"

# Security & Admin Authentication (Required)
# Generate random 64-char hex strings for production
SESSION_SECRET="replace_with_a_long_random_session_secret_at_least_32_chars"
ADMIN_SETUP_TOKEN="replace_with_a_one_time_admin_setup_token"

# Google OAuth 2.0 for Private Admin Sign-In (Required)
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
# Authorized Google email for Admin Dashboard (optional if configured via /admin/setup)
ADMIN_ALLOWED_EMAIL="gideonkwesiansah@gmail.com"

# Cloudinary Configuration for Image & PDF Uploads (Required for media/CV uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Application URL (Injected automatically in AI Studio Cloud Run)
APP_URL="http://localhost:3000"
